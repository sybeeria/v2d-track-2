+def test_warp_geodesic_angle_is_shortest_and_sign_invariant():
+    import warp as wp
+
+    from flash_chord.utils.quat import quat_geodesic_angle
+
+    @wp.kernel
+    def measure_angles(a: wp.array(dtype=wp.quat), b: wp.array(dtype=wp.quat), angles: wp.array(dtype=float)):
+        i = wp.tid()
+        angles[i] = quat_geodesic_angle(wp.normalize(a[i]), wp.normalize(b[i]))
+
+    angles = np.asarray([0.0, 0.4, np.pi / 2, np.pi, 3 * np.pi / 2])
+    quats = np.zeros((len(angles), 4), dtype=np.float32)
+    quats[:, 2] = np.sin(angles / 2)
+    quats[:, 3] = np.cos(angles / 2)
+    quats = np.concatenate([quats, -quats])
+    targets = np.tile([0.0, 0.0, 0.0, 1.0], (len(quats), 1))
+    with wp.ScopedDevice("cpu"):
+        result = wp.zeros(len(quats), dtype=float)
+        wp.launch(
+            measure_angles,
+            dim=len(quats),
+            inputs=[wp.array(quats, dtype=wp.quat), wp.array(targets, dtype=wp.quat)],
+            outputs=[result],
+        )
+    expected = np.minimum(angles, 2 * np.pi - angles)
+    np.testing.assert_allclose(result.numpy(), np.tile(expected, 2), atol=1.0e-6)
+    np.testing.assert_array_equal(result.numpy()[: len(angles)], result.numpy()[len(angles) :])
