+@pytest.mark.parametrize(
+    "root,experiment", [("train_flash_sac", "g1_recon_body_flash_sac"), ("train", "g1_recon_body_ppo")]
+)
+@pytest.mark.parametrize("weight", [0.0, 1.0])
+def test_recon_body_orientation_weight_reaches_every_curriculum_stage(root, experiment, weight):
+    from flash_chord.lifecycle.curriculum import FixedCurriculum
+    from flash_chord.objectives.recon_body import RECON_BODY_OBJECTIVE_TERM_NAMES, ReconBodyObjectiveConfig
+
+    overrides = [f"experiment={experiment}", _PARQUET]
+    if weight:
+        overrides.append(f"objective.object_orientation_weight={weight}")
+    config = compose_config(root, overrides)
+    objective = instantiate_typed(config.env.objective, ReconBodyObjectiveConfig)
+    curriculum = instantiate_typed(config.curriculum, FixedCurriculum)
+
+    assert objective.object_orientation_weight == weight
+    assert objective.object_orientation_std == 0.4
+    assert len(curriculum.stages) == 9
+    for stage in curriculum.stages:
+        weights = stage.weights_for(RECON_BODY_OBJECTIVE_TERM_NAMES)
+        assert weights[RECON_BODY_OBJECTIVE_TERM_NAMES.index("object_orientation")] == weight
+
+
+def test_recon_body_orientation_stage_weight_can_override_the_shared_default():
+    config = compose_config(
